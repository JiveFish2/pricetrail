# Same database the collector writes to.
DATABASE_URL=postgresql://pricetrail:pricetrail@localhost:5433/pricetrail

# Public address of the site; used in emails and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Resend (https://resend.com). Without a key, emails are printed to the server log.
RESEND_API_KEY=
ALERT_FROM=PriceTrail <alerts@example.com>

# Shared with the collector workflow: POST /api/revalidate with "Authorization: Bearer <secret>".
REVALIDATE_SECRET=change-me
